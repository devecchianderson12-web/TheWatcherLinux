#!/bin/sh
# Instalador gráfico de .deb. gdebi muestra nombre, versión y descripción, resuelve dependencias con apt y avisa de los errores.
# La ISO no trae los índices de apt (ahorran espacio): sin ellos gdebi no podría resolver dependencias.
lpc-polkit
file=$1
if [ -z "$file" ]; then
  file=$(zenity --file-selection --title="Elegir un paquete .deb" --file-filter="Paquetes .deb | *.deb") || exit 0
fi
if ! ls /var/lib/apt/lists/*_Packages* >/dev/null 2>&1; then
  pkexec apt-get update | zenity --progress --pulsate --auto-close --no-cancel --title="Actualizando la lista de paquetes" --text="Hace falta Internet para resolver dependencias"
fi
exec gdebi-gtk "$file"
