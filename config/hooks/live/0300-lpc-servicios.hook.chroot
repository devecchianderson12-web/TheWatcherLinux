#!/bin/sh
# Solo lo que consume sin aportar. Se mantienen: red, udev, dbus, logind, journald, timesyncd, RustDesk y zram.
set -e
for u in apt-daily.timer apt-daily-upgrade.timer man-db.timer e2scrub_all.timer e2scrub_reap.service \
         NetworkManager-wait-online.service remote-fs.target; do
  systemctl disable "$u" 2>/dev/null || true
done
systemctl mask systemd-networkd-wait-online.service 2>/dev/null || true
systemctl enable NetworkManager.service systemd-timesyncd.service
# Xorg y GTK no necesitan esto en una sola sesión gráfica
rm -f /etc/xdg/autostart/at-spi-dbus-bus.desktop
