# Versiones fijadas. Para actualizar un componente: cambiar versión y SHA-256 (ver docs/ACTUALIZAR.md).
DISTRO_NAME="TheWatcher Linux"
DISTRO_ID="thewatcher-linux"
DISTRO_VERSION="${DISTRO_VERSION:-0.1.1}"      # la release de GitHub la pasa por variable

DEBIAN_SUITE="trixie"
DEBIAN_MIRROR="https://deb.debian.org/debian/"
DEBIAN_SECURITY_MIRROR="https://deb.debian.org/debian-security/"

RUSTDESK_VERSION="1.5.0"
RUSTDESK_URL="https://github.com/rustdesk/rustdesk/releases/download/${RUSTDESK_VERSION}/rustdesk-${RUSTDESK_VERSION}-x86_64.deb"
RUSTDESK_SHA256="4e2b9701d25a7ef373f3d09bda584a37d6902f97a6ab15f2e86d4a5783e2a0ec"

# The Watcher viene en packages/: no tiene descarga pública, y para cambiarlo se reemplaza ese archivo
THEWATCHER_DEB="thewatcher_1.1.6_amd64.deb"
THEWATCHER_SHA256="02d4601682aac5cf75759fcbb7cf4e27450aab3fcc0c9b56c28381afa990facc"
